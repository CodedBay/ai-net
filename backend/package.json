{
  "name": "ai-net-backend",
  "private": true,
  "version": "0.1.0",
  "description": "ai-net backend \u2014 Node.js/TypeScript server bridging frontend, agent runtime, Stellar payments, and Venice AI.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:migrations": "jest --config jest.migrations.config.js --runInBand --forceExit",
    "test:e2e": "jest --config ../tests/e2e/jest.config.js --runInBand --forceExit",
    "test:performance": "tsx tests/performance/run.ts",
    "benchmark:indexes": "tsx scripts/benchmark-indexes.ts",
    "db:migrate": "ts-node src/db/cli.ts migrate",
    "db:rollback": "ts-node src/db/cli.ts rollback",
    "db:seed": "ts-node src/db/cli.ts seed",
    "docs:generate": "typedoc --options typedoc.json"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@stellar/stellar-base": "^12.1.1",
    "@stellar/stellar-sdk": "12.3.0",
    "better-sqlite3": "^13.0.3",
    "compression": "1.7.5",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "ioredis": "^6.0.0",
    "lru-cache": "^10.4.3",
    "nanoid": "^3.3.7",
    "pino": "^10.3.1",
    "pino-http": "10.2.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.17",
    "@types/jest": "29.5.12",
    "@types/node": "20.19.43",
    "@types/pino": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "8.57.0",
    "jest": "29.7.0",
    "jest-openapi": "^0.14.2",
    "msw": "^3.0.3",
    "prettier": "^3.2.5",
    "prettier2": "npm:prettier@^2.8.8",
    "supertest": "^7.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsx": "^4.23.15",
    "typedoc": "0.28.20",
    "typescript": "^5.4.5"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true
  }
}
