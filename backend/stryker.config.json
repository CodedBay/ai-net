{
  "$schema": "https://stryker-mutator.io/schemas/stryker-schema.json",
  "testRunner": "@stryker-mutator/jest-runner",
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/payment/**/*.ts",
    "src/coordinator/**/*.ts",
    "src/services/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts",
    "!src/**/*.d.ts",
    "!src/**/.gitkeep"
  ],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": 70
  },
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/backend/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/backend/report.json"
  },
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js",
    "enableFindRelatedTests": true
  },
  "ignoreStatic": true,
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": "always",
  "concurrency": 2,
  "timeoutMS": 60000,
  "timeoutFactor": 2
}
