exports[`AgentDetailPage > renders 404 empty state when notFound=true 1`] = `
<div>
  <div
    class="_page_0b2b55"
    data-testid="agent-not-found"
  >
    <div
      class="_container_74c43e"
      data-testid="empty-state"
    >
      <h3
        class="_title_74c43e"
      >
        Agent not found
      </h3>
      <div
        class="_description_74c43e"
      >
        <p>
          No agent with this ID exists in the registry.
        </p>
      </div>
      <div
        class="_actions_74c43e"
      >
        <button
          class="_primaryBtn_74c43e"
          data-testid="empty-state-primary-cta"
          type="button"
        >
          <span>
            Browse Registry
          </span>
        </button>
      </div>
    </div>
  </div>
</div>
`;

exports[`AgentDetailPage > renders error state with browse registry link 1`] = `
<div>
  <div
    class="_page_0b2b55"
    data-testid="agent-error"
  >
    <div
      class="_errorBox_0b2b55"
      role="alert"
    >
      <p>
        Failed to load agent
      </p>
      <a
        class="_backLink_0b2b55"
        href="/agents"
      >
        ← 
        Browse Registry
      </a>
    </div>
  </div>
</div>
`;

