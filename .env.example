# Core local runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Log SQL statements slower than this (ms); 0 = all, negative = disabled
SLOW_QUERY_LOG_THRESHOLD_MS=100

# Project metadata
NPM_PACKAGE_VERSION=0.1.0
GRACEFUL_SHUTDOWN_TIMEOUT=30

# Backend database / cache
DATABASE_URL=sqlite:///workspace/backend/data/ai-net.db
REDIS_URL=redis://localhost:6379
CACHE_DRIVER=lru

# Network and contract deployment
STELLAR_NETWORK=standalone
STELLAR_HORIZON_URL=http://localhost:8000
SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
STELLAR_SECRET_KEY=
REGISTRY_CONTRACT_ID=
DEPLOYED_CONTRACT_IDS=
SKIP_STELLAR_ACCOUNT_VERIFY=true

# Backend auth and CORS
ALLOWED_ORIGINS=http://localhost:5173
API_KEYS=
ADMIN_API_KEY=
VENICE_API_KEY=mock_local_key

# Frontend
VITE_API_BASE_URL=http://localhost:3000
VITE_STELLAR_NETWORK=standalone
VITE_SOROBAN_RPC_URL=http://localhost:8000/soroban/rpc
VITE_PORT=5173

# Local docker-compose defaults
COMPOSE_PROJECT_NAME=ai-net
BACKEND_PORT=3000
FRONTEND_PORT=5173
STELLAR_RPC_PORT=8000
STELLAR_HORIZON_PORT=11626
